# 이 파일을 복사해 .env 를 만들고 값을 채우세요. .env 는 커밋하지 않습니다.
# 서버가 시작할 때 저장소 루트의 .env 를 읽습니다. (Spring Boot spring.config.import)

# --- 데이터베이스 (0단계부터 사용) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ticket_radar
DB_USER=root
DB_PASSWORD=

# --- 서버 포트 (기본 8080) ---
SERVER_PORT=8080

# --- 관리자 화면 비밀번호 (2단계부터 사용, HTTP Basic) ---
ADMIN_PASSWORD=

# --- Claude API (4단계부터 사용. 비워 두면 AI 없이 동작 = fallback) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
