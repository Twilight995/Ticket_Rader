# 이 파일을 복사해 .env 를 만들고 값을 채우세요. .env 는 커밋하지 않습니다.
# 서버가 시작할 때 저장소 루트의 .env 를 읽습니다. (Spring Boot spring.config.import)

# --- 데이터베이스 (0단계부터 사용) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ticket_radar
DB_USER=root
DB_PASSWORD=

# --- 서버 포트 (기본 8080) ---
SERVER_PORT=8080

# --- 관리자 화면 비밀번호 (2단계부터 사용, HTTP Basic) ---
ADMIN_PASSWORD=

# --- AI 추출 (4단계, ADR 5). 공급자: none | gemini | claude. 키가 비어 있으면 none 과 같다 (= 항상 fallback) ---
AI_PROVIDER=gemini
# 모델 ID는 Google AI Studio 에 보이는 이름을 그대로 적는다 (예: 무료 티어 flash-lite). 한도가 넉넉한 모델을 고른다.
AI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# Claude 로 바꿀 때: AI_PROVIDER=claude, AI_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
